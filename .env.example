# Core
DATABASE_URL=postgresql+psycopg://user:password@host:5432/chimera
API_ENVIRONMENT=development
CHIMERA_ALLOW_LIVE_EXECUTION=false

# Razorpay payment links
PAYMENT_PROVIDER=razorpay
PAYMENT_ENABLED=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=TEST

# Twilio WhatsApp Sandbox
MESSAGING_PROVIDER=twilio
MESSAGING_CHANNEL=whatsapp
MESSAGING_ENABLED=true
TWILIO_WHATSAPP_FROM_NUMBER=whatsapp:+14155238886
# Optional fallback; the persisted Razorpay customer phone is preferred.
TWILIO_WHATSAPP_TO_NUMBER=whatsapp:+91XXXXXXXXXX
# Required for proactive business-initiated Sandbox messages.
TWILIO_WHATSAPP_CONTENT_SID=HX...
MESSAGING_PUBLIC_BASE_URL=https://your-public-backend.example.com

# Twilio trial voice (verified destination numbers only)
VOICE_PROVIDER=twilio
VOICE_ENABLED=false
VOICE_PHONE_NUMBER=
VOICE_PUBLIC_BASE_URL=https://your-public-backend.example.com
VOICE_LANGUAGE=hi-IN
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VOICE_MODE=TEST

# Exotel trial voice (verified destination numbers only until KYC approval)
# Use VOICE_PROVIDER=exotel instead of twilio when testing Exotel.
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
# App ID of the call flow created in App Bazaar. With the account SID, CHIMERA derives
# https://my.exotel.com/<account-sid>/exoml/start_voice/<app-id>.
EXOTEL_APP_ID=
# Optional override if Exotel gives you a complete flow URL.
EXOTEL_FLOW_URL=
# Active Exotel number shown to the customer as caller ID.
EXOTEL_CALLER_ID=
EXOTEL_API_BASE_URL=https://api.in.exotel.com
# Optional CHIMERA-generated token appended to the callback URL; Exotel does not issue this.
EXOTEL_WEBHOOK_SECRET=
# WSS destination used by CHIMERA's HTTPS resolver for a published Flow Voicebot applet,
# or used directly when Exotel AgentStream call creation is enabled.
EXOTEL_AGENTSTREAM_ENABLED=false
EXOTEL_STREAM_URL=wss://your-public-backend.example.com/api/v1/voice/exotel/stream
# Configure this HTTPS URL inside the Exotel Voicebot applet:
# https://your-public-backend.example.com/api/v1/voice/exotel/stream-resolver

# Vobiz programmable cloud telephony (India voice AI outbound)
# Use VOICE_PROVIDER=vobiz when using Vobiz.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_CALLER_ID=
VOBIZ_API_BASE_URL=https://api.vobiz.ai
# Automatically resolved from VOICE_PUBLIC_BASE_URL if left empty:
# VOBIZ_STREAM_URL=wss://your-public-backend.example.com/api/v1/voice/vobiz/stream

# Ultra-low-latency Hinglish reasoning (Groq LPU)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# India-first Hinglish voice intelligence (Sarvam Saaras + Bulbul)
SARVAM_ENABLED=false
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_LANGUAGE_CODE=hi-IN
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=codemix
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TIMEOUT_SECONDS=20
SARVAM_MODE=TEST

# Browser voice demo (Pipecat + Sarvam). Keep this separate from Exotel/Twilio.
PIPECAT_SARVAM_LLM_MODEL=sarvam-105b
# Comma-separated browser origins accepted by the local Pipecat WebSocket.
PIPECAT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003
# Browser-visible FastAPI WebSocket base; use wss://<api-host>/api/v1 in production.
NEXT_PUBLIC_API_WS_BASE_URL=ws://localhost:8000/api/v1

# Optional Telegram operator notification; internal escalation queue is always available.
ESCALATION_PROVIDER=telegram
ESCALATION_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ESCALATION_MODE=TEST

# Existing local/provider defaults
MESSAGING_TIMEOUT_SECONDS=10
VOICE_TIMEOUT_SECONDS=10
ESCALATION_TIMEOUT_SECONDS=10
RETRY_PROVIDER=local
