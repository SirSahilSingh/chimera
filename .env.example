# Core
DATABASE_URL=postgresql+psycopg://user:password@host:5432/chimera
API_ENVIRONMENT=development
CHIMERA_ALLOW_LIVE_EXECUTION=false

# Razorpay payment links
PAYMENT_PROVIDER=razorpay
PAYMENT_ENABLED=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=TEST

# Twilio WhatsApp Sandbox
MESSAGING_PROVIDER=twilio
MESSAGING_CHANNEL=whatsapp
MESSAGING_ENABLED=true
TWILIO_WHATSAPP_FROM_NUMBER=whatsapp:+14155238886
# Optional fallback; the persisted Razorpay customer phone is preferred.
TWILIO_WHATSAPP_TO_NUMBER=whatsapp:+91XXXXXXXXXX
# Required for proactive business-initiated Sandbox messages.
TWILIO_WHATSAPP_CONTENT_SID=HX...
MESSAGING_PUBLIC_BASE_URL=https://your-public-backend.example.com

# Twilio trial voice (verified destination numbers only)
VOICE_PROVIDER=twilio
VOICE_ENABLED=false
VOICE_PHONE_NUMBER=
VOICE_PUBLIC_BASE_URL=https://your-public-backend.example.com
VOICE_LANGUAGE=hi-IN
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VOICE_MODE=TEST

# Exotel trial voice (verified destination numbers only until KYC approval)
# Use VOICE_PROVIDER=exotel instead of twilio when testing Exotel.
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
# Copy the complete Exotel flow URL created in App Bazaar.
EXOTEL_FLOW_URL=
# Active Exotel number shown to the customer as caller ID.
EXOTEL_CALLER_ID=
EXOTEL_API_BASE_URL=https://api.in.exotel.com
# Optional shared token appended to the Exotel status callback URL.
EXOTEL_WEBHOOK_SECRET=

# India-first Hinglish voice intelligence (Sarvam Saaras + Bulbul)
SARVAM_ENABLED=false
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_LANGUAGE_CODE=hi-IN
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=codemix
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TIMEOUT_SECONDS=20
SARVAM_MODE=TEST

# Optional Telegram operator notification; internal escalation queue is always available.
ESCALATION_PROVIDER=telegram
ESCALATION_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ESCALATION_MODE=TEST

# Existing local/provider defaults
MESSAGING_TIMEOUT_SECONDS=10
VOICE_TIMEOUT_SECONDS=10
ESCALATION_TIMEOUT_SECONDS=10
RETRY_PROVIDER=local
